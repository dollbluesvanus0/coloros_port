# 需要移植的分区
partition_to_port=system,system_ext,product,my_product,my_engineering,my_stock,my_heytap,my_carrier,my_region,my_bigball,my_manifest,my_company,my_preload


# 可能的super子分区列表
possible_super_list=system system_ext vendor product my_product odm my_engineering vendor_dlkm system_dlkm my_stock my_heytap my_carrier my_region my_bigball my_manifest my_company my_preload

# 打包为 ext4 文件系统（如果底包是erofs） true:是  false:否    意义：解锁system
# Packing/Repacking target ROM filesystem with EXT4 or not. wiht EXT4, you can mount system parititon in read-write mode, which is not possible for EROFS filesystem. 
repack_with_ext4=false

# 去除data加密   true:是  false:否
# Remove data encryption or not. if it is false, you cannot access encrypted-data partition in recovery without a A14 supported TWRP.
remove_data_encryption=false

# Needed to manually extend super partition, in order to flash it successfully. 
super_extended=false

pack_with_dsu=false

# 打包方式: ota (默认，生成带 payload.bin 的 Recovery OTA 刷机包) 或 fastboot (生成带 super.zst 和 fastboot 刷机脚本的线刷包)
# Packaging method: ota (default, recovery package with payload.bin) or fastboot (fastboot flashable package with super.zst and flash scripts)
pack_method=ota

# Concurrent partition packing: auto (up to 2, reduced on low-memory hosts),
# or 1..32. PORT_PACK_JOBS overrides this setting; 1 keeps packing sequential.
pack_jobs=auto

# Concurrent APK/JAR patching: auto (min(cpus, 4)), or 1..32.
# PORT_PATCH_JOBS overrides this setting; 1 keeps patching sequential.
patch_jobs=auto

# OTA payload generation engine for A/B devices:
# auto (rust payload-gen -> delta_generator -> ota_from_target_files),
# rust (coloros-tools payload-gen), delta (direct delta_generator), stock (ota_from_target_files).
# PORT_OTA_ENGINE overrides this setting.
ota_engine=auto

# Payload compression for rust payload-gen: fast-xz (default), xz, bz2, none.
# PORT_PAYLOAD_COMPRESSION overrides this setting.
payload_compression=fast-xz

#ddr_type=ddr5

#给其他机型移植时，已近处理过的包，可以复用，不用再处理。

reusabe_partition_list=my_bigball my_heytap my_stock my_region product

# 启用 KernelSU 支持 (需要 init_boot 分区)
# Enable KernelSU support (requires init_boot partition)
# KernelSU is opt-in. Enabling it changes boot images and adds root
# capabilities; use an explicit environment/device override when required.
enable_ksu=false

# KernelSU GitHub 仓库配置 (可选)
# KernelSU GitHub repository configuration (optional)
# ksu_repo_owner=tiann
# ksu_repo_name=KernelSU
# Pinned KernelSU Manager GitHub Actions run ID (tiann/KernelSU@2a60b28, v3.3.1-55-g2a60b289 / 32735).
# Set to "latest" to download the latest GitHub release instead.
ksu_manager_run_id=44884831714

# 预装应用 (Via 浏览器、Google Play 商店、KernelSU 管理器)
# Preinstalled apps (Via Browser, Google Play Store, KernelSU Manager)
install_via=true
install_play_store=true
install_kernelsu=true
