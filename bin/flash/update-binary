#!/sbin/sh
ui_print() {
  if [ "${BOOTMODE:-false}" = true ]; then
    echo "$1"
  else
    echo -e "ui_print $1\nui_print" >> "$OUTFD"
  fi
}
abort() { ui_print "$1"; ui_print " "; exit 1; }
OUTFD=/proc/self/fd/$2
ZIPFILE="$3"
tmp=/dev/tmp

rm -rf "$tmp"
mkdir -p "$tmp" || abort "Unable to prepare temporary directory"

package_has_file() {
  unzip -l "$ZIPFILE" 2>/dev/null | awk -v entry="$1" '$NF == entry { found = 1 } END { exit !found }'
}

require_package_file() {
  package_has_file "$1" || abort "Required package file is missing: $1"
}

require_partition() {
  [ -e "$1" ] || abort "Required partition is unavailable: $1"
}

package_extract_file() {
  entry="$1"
  target="$2"
  if ! package_has_file "$entry"; then
    ui_print "- Skipping missing optional image: $entry"
    return 0
  fi
  if [ ! -e "$target" ]; then
    ui_print "- Skipping unavailable optional partition: $target"
    return 0
  fi
  unzip -p "$ZIPFILE" "$entry" > "$target" || abort "Failed to flash $entry to $target"
}

package_extract_zstd() {
  ui_print "- Flashing $(basename "$2")"
  unzip -p "$ZIPFILE" "$1" | /dev/tmp/META-INF/zstd -c -d > "$2" || abort "Failed to decompress or flash $1"
}

ddr4=false
ddr5=false

# Refuse to flash a package onto an unrelated device. Some recoveries expose
# only one of these product properties, so accept a match from any available
# product property or the bootloader project identifier.
expected_device="device_code"
expected_project="PROJECT_CODE"
device_matches=false
for property in ro.product.device ro.build.product ro.product.vendor.device ro.product.odm.device; do
  current_device="$(getprop "$property" 2>/dev/null)"
  if [ -n "$current_device" ] && [ "$current_device" = "$expected_device" ]; then
    device_matches=true
  fi
done
current_project="$(getprop ro.boot.prjname 2>/dev/null)"
[ -n "$current_project" ] || current_project="$(getprop ro.boot.project_name 2>/dev/null)"
if [ -n "$expected_project" ] && [ "$current_project" = "$expected_project" ]; then
  device_matches=true
fi
[ -n "$expected_device" ] && [ "$expected_device" != "device_""code" ] || abort "Package device identity was not generated"
[ "$device_matches" = true ] || abort "Package is for $expected_device; this device does not match"

# Validate the archive before opening any block device for writing.
unzip -t "$ZIPFILE" >/dev/null 2>&1 || abort "Package archive validation failed"

# Select and validate the boot image pair before touching firmware partitions.
# Support both filename-based ROOT selection and sideloaded archives (/sideload/package.zip).
boot_image="boot_official.img"
dtbo_image="firmware-update/dtbo.img"
if package_has_file "boot_ksu.img"; then
  case "$ZIPFILE" in
    *ROOT*)
      boot_image="boot_ksu.img"
      ;;
    *)
      if ! package_has_file "boot_official.img"; then
        boot_image="boot_ksu.img"
      fi
      ;;
  esac
fi
if [ "$boot_image" != "boot_official.img" ] && package_has_file "firmware-update/dtbo_ksu.img"; then
  dtbo_image="firmware-update/dtbo_ksu.img"
fi

require_package_file "$boot_image"
require_package_file "$dtbo_image"
require_package_file "super.zst"
require_package_file "META-INF/zstd"
require_partition "/dev/block/bootdevice/by-name/boot_a"
require_partition "/dev/block/bootdevice/by-name/boot_b"
require_partition "/dev/block/bootdevice/by-name/dtbo_a"
require_partition "/dev/block/bootdevice/by-name/dtbo_b"
require_partition "/dev/block/bootdevice/by-name/super"

# Extract the decompressor before any partition writes.
mkdir -p /dev/tmp/META-INF || abort "Unable to prepare decompressor directory"
unzip -p "$ZIPFILE" "META-INF/zstd" > /dev/tmp/META-INF/zstd || abort "Unable to extract zstd"
chmod 0755 /dev/tmp/META-INF/zstd || abort "Unable to prepare zstd"

# Only older devices with LP5-specific XBL images need RAM-type detection.
if package_has_file "firmware-update/xbl_lp5.img"; then
  require_package_file "firmware-update/xbl_config_lp5.img"
  ui_print "Checking RAM type..."
  ddr_type="$(cat /proc/devinfo/ddr_type 2>/dev/null)"
  if printf '%s\n' "$ddr_type" | grep -qi DDR4; then
    ddr4=true
    ui_print "- DDR4 RAM detected!"
  elif printf '%s\n' "$ddr_type" | grep -qi DDR5; then
    ddr5=true
    ui_print "- DDR5 RAM detected!"
  else
    case "$(getprop ro.boot.ddr_type 2>/dev/null)" in
      0) ddr4=true; ui_print "- DDR4 RAM detected!" ;;
      1) ddr5=true; ui_print "- DDR5 RAM detected!" ;;
      *) abort "Unable to detect RAM type required to choose the matching XBL firmware" ;;
    esac
  fi
fi

ui_print " "
ui_print "****************************"
ui_print "Device: device_code"
ui_print "Region: REGIONMARK"
ui_print " "

for fw_part in \
  modem abl aop aop_config bluetooth cmnlib cmnlib64 cpucp devcfg dsp \
  engineering_cdt featenabler hyp imagefv keymaster logo multiimgoem \
  oplus_sec oplusstanvbk qupfw recovery shrm splash storsec tz uefi \
  uefisecapp vendor_boot init_boot
do
  if package_has_file "firmware-update/${fw_part}.img"; then
    ui_print "Updating ${fw_part}..."
    package_extract_file "firmware-update/${fw_part}.img" "/dev/block/bootdevice/by-name/${fw_part}_a"
    package_extract_file "firmware-update/${fw_part}.img" "/dev/block/bootdevice/by-name/${fw_part}_b"
  fi
done
package_extract_file "firmware-update/mdm_oem_stanvbk.img" "/dev/block/bootdevice/by-name/mdm_oem_stanvbk"
package_extract_file "firmware-update/spunvm.img" "/dev/block/bootdevice/by-name/spunvm"

if [ "$ddr4" = "true" ]; then
  ui_print "Updating xbl for DDR4 RAM..."
  package_extract_file "firmware-update/xbl.img" "/dev/block/bootdevice/by-name/xbl_a"
  package_extract_file "firmware-update/xbl.img" "/dev/block/bootdevice/by-name/xbl_b"
  ui_print "Updating xbl_config for DDR4 RAM..."
  package_extract_file "firmware-update/xbl_config.img" "/dev/block/bootdevice/by-name/xbl_config_a"
  package_extract_file "firmware-update/xbl_config.img" "/dev/block/bootdevice/by-name/xbl_config_b"
elif [ "$ddr5" = "true" ]; then
  ui_print "Updating xbl for DDR5 RAM..."
  package_extract_file "firmware-update/xbl_lp5.img" "/dev/block/bootdevice/by-name/xbl_a"
  package_extract_file "firmware-update/xbl_lp5.img" "/dev/block/bootdevice/by-name/xbl_b"
  ui_print "Updating xbl_config for DDR5 RAM..."
  package_extract_file "firmware-update/xbl_config_lp5.img" "/dev/block/bootdevice/by-name/xbl_config_a"
  package_extract_file "firmware-update/xbl_config_lp5.img" "/dev/block/bootdevice/by-name/xbl_config_b"
else
  ui_print "Updating xbl (if included)..."
  package_extract_file "firmware-update/xbl.img" "/dev/block/bootdevice/by-name/xbl_a"
  package_extract_file "firmware-update/xbl.img" "/dev/block/bootdevice/by-name/xbl_b"
  package_extract_file "firmware-update/xbl_config.img" "/dev/block/bootdevice/by-name/xbl_config_a"
  package_extract_file "firmware-update/xbl_config.img" "/dev/block/bootdevice/by-name/xbl_config_b"
fi

ui_print "Disabling AVB2.0..."
for vb_part in vbmeta vbmeta_system vbmeta_vendor; do
  package_extract_file "firmware-update/${vb_part}.img" "/dev/block/bootdevice/by-name/${vb_part}_a"
  package_extract_file "firmware-update/${vb_part}.img" "/dev/block/bootdevice/by-name/${vb_part}_b"
done

# boot & dtbo
if [ "$boot_image" != "boot_official.img" ]; then
  ui_print "Flashing custom boot image ($boot_image)..."
else
  ui_print "Flashing stock boot image ($boot_image)..."
fi
package_extract_file "$boot_image" "/dev/block/bootdevice/by-name/boot_a"
package_extract_file "$boot_image" "/dev/block/bootdevice/by-name/boot_b"
ui_print "Flashing dtbo image ($dtbo_image)..."
package_extract_file "$dtbo_image" "/dev/block/bootdevice/by-name/dtbo_a"
package_extract_file "$dtbo_image" "/dev/block/bootdevice/by-name/dtbo_b"

# super image
package_extract_zstd "super.zst" "/dev/block/bootdevice/by-name/super"

#REMAP_START
if command -v lptools >/dev/null 2>&1; then
  for dyn_part in \
    odm_a mi_ext_a system_a vendor_a product_a odm_dlkm_a system_ext_a \
    vendor_dlkm_a system_dlkm_a my_product_a my_engineering_a my_company_a \
    my_carrier_a my_region_a my_heytap_a my_stock_a my_preload_a \
    my_bigball_a my_manifest_a
  do
    dyn_part_b="${dyn_part%_a}_b"
    if [ -e "/dev/block/mapper/${dyn_part_b}" ]; then lptools unmap "$dyn_part_b" >/dev/null 2>&1 || true; fi
    if [ -e "/dev/block/mapper/${dyn_part}" ]; then
      lptools unmap "$dyn_part" >/dev/null 2>&1 || true
      lptools map "$dyn_part" >/dev/null 2>&1 || true
    fi
  done
fi
#REMAP_END

# SET_ACTION_SLOT_A_BEGIN
if command -v bootctl >/dev/null 2>&1; then
  bootctl set-active-boot-slot 0 >/dev/null 2>&1 || true
fi
if command -v twrp >/dev/null 2>&1; then
  twrp set_active a >/dev/null 2>&1 || true
fi
# SET_ACTION_SLOT_A_END

rm -rf /data/dalvik-cache/arm/* 2>/dev/null || true
rm -rf /data/dalvik-cache/arm64/* 2>/dev/null || true
rm -rf /data/system/package_cache/* 2>/dev/null || true
ui_print " "
ui_print "Flashing completed."
ui_print " "

exit 0
